# Copy to .env and fill in real values. .env is git-ignored; never commit it.
#   cp .env.example .env

# --- Runtime ports (reserved for this project) ---
WEB_PORT=9180
API_PORT=9181

# --- Backend (FastAPI) ---
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:9180

# Create the tables and load the fictional demo data on startup when the DB is empty
DB_AUTO_SEED=true

# Auth (real JWT, HS256). Generate a secret with:  openssl rand -hex 32
# Empty = a random per-process secret in development (tokens reset on restart);
# APP_ENV=production refuses to start without a secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=scmp-ai-assignment
# The JWT is delivered in an httpOnly cookie set by the API. Set true when served over https.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=scmp_session
# Mock Google SSO: lists the fictional seed users and signs in without a password.
# Set to false to disable /api/auth/mock-users and /api/auth/mock-google/login.
MOCK_SSO_ENABLED=true

# LLM provider: gemini | ollama | fake (fake is deterministic, for tests/offline)
LLM_PROVIDER=gemini
# Used automatically when the primary fails (bad key, quota, outage). Empty = no fallback.
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_COOLDOWN_SECONDS=300
# Local Ollama. From Docker use http://host.docker.internal:11434 (compose sets this).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_VISION_MODEL=gemma4:latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# ReqRes hosted mock API. Assignment endpoint: POST /api/users
REQRES_BASE_URL=https://reqres.in/api/users
REQRES_API_KEY=
# ReqRes currently needs no key; the header is sent only when this is set.
# reqres = the hosted mock API required by the assignment.
# fake = offline development / automated tests only; it is NOT the ReqRes integration.
SUBMISSION_PROVIDER=reqres

# Attachments (image or PDF), stored on the server disk (a Docker volume in compose)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# --- Frontend (Nuxt) ---
# Browser-facing URL of the FastAPI backend
NUXT_PUBLIC_API_BASE=http://localhost:9181

# Theme (Nuxt runtimeConfig.public.theme.*; overridable at runtime)
NUXT_PUBLIC_THEME_LIGHT_PRIMARY=#32a9e1
NUXT_PUBLIC_THEME_LIGHT_SECONDARY=#1e40af
NUXT_PUBLIC_THEME_LIGHT_BACKGROUND=#ffffff
NUXT_PUBLIC_THEME_DARK_PRIMARY=#7dd3fc
NUXT_PUBLIC_THEME_DARK_SECONDARY=#94a3b8
NUXT_PUBLIC_THEME_DARK_BACKGROUND=#020617
