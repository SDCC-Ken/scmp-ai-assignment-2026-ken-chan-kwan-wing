# Copy to .env and fill in real values. .env is git-ignored; never commit it.
#   cp .env.example .env

# --- Runtime ports (reserved for this project) ---
WEB_PORT=9180
API_PORT=9181

# --- Backend (FastAPI) ---
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:9180

# LLM provider: gemini | fake (fake is deterministic, for tests/offline)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# ReqRes hosted mock API (requires x-api-key). Assignment endpoint: POST /api/users
REQRES_BASE_URL=https://reqres.in/api/users
REQRES_API_KEY=

# --- Frontend (Nuxt) ---
# Browser-facing URL of the FastAPI backend
NUXT_PUBLIC_API_BASE=http://localhost:9181

# Theme (Nuxt runtimeConfig.public.theme.*; overridable at runtime)
NUXT_PUBLIC_THEME_LIGHT_PRIMARY=#32a9e1
NUXT_PUBLIC_THEME_LIGHT_SECONDARY=#1e40af
NUXT_PUBLIC_THEME_LIGHT_BACKGROUND=#ffffff
NUXT_PUBLIC_THEME_DARK_PRIMARY=#7dd3fc
NUXT_PUBLIC_THEME_DARK_SECONDARY=#94a3b8
NUXT_PUBLIC_THEME_DARK_BACKGROUND=#020617
