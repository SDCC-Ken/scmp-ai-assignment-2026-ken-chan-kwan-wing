# Secrets - never commit
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / Nuxt
node_modules/
.nuxt/
.output/
.nitro/
.cache/
dist/
*.log
npm-debug.log*

# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Local data (SQLite databases, uploads). Keep packaged application resources
# such as backend/app/resources/ under version control.
/data/
/backend/data/
*.db
*.sqlite
*.sqlite3

# Recordings / scratch that may contain secrets
*.mov
*.mp4
scratch/
